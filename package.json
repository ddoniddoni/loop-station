{
  "name": "loop-station",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:audio && next dev",
    "build": "npm run build:audio && next build --webpack",
    "build:audio": "esbuild src/audio/worklets/test-tone-processor.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=public/audio/test-tone-processor.js",
    "watch:audio": "npm run build:audio -- --watch",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audio": "vitest run tests/audio",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "description": "Local-first browser loop station. Initial project foundation.",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11 <12"
  }
}
